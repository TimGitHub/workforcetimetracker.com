{
  "name": "Workforce Time Tracker",
  "short_name": "Workforce TT",
  "description": "Offline desktop time tracker for Windows and macOS. No account, no cloud, no telemetry. Local-first; multi-device sync via your own folder.",
  "start_url": "/",
  "scope": "/",
  "display": "browser",
  "background_color": "#09090b",
  "theme_color": "#0891B2",
  "icons": [
